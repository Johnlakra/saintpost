# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
TELEGRAM_WEBHOOK_URL=https://your-app.onrender.com/webhook
WEBHOOK_SECRET=saintpost_webhook_secret_key

# Neon PostgreSQL Connection
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# AI Model Keys (Free Tier / OpenRouter / Hugging Face)
OPENROUTER_API_KEY=your_openrouter_api_key
# Leave blank to auto-pick a currently-free model. Names that no longer exist are skipped.
OPENROUTER_MODEL=
# OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-001,deepseek/deepseek-chat
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Visual Generation (FLUX / Replicate / Fal)
REPLICATE_API_TOKEN=your_replicate_token
FAL_API_KEY=your_fal_key
# More free image fallbacks (all optional; used in this order after fal.ai): Gemini -> Cloudflare -> Together -> HuggingFace -> Replicate -> Pollinations
GEMINI_API_KEY=            # aistudio.google.com/apikey (free tier; also accepts a reference photo for accurate faces)
# BEST FREE OPTION: Cloudflare Workers AI = 10,000 free neurons per day (renews 00:00 UTC), no credit card.
# FLUX.2 klein (takes reference photos for consistent faces) + FLUX.1 schnell + SDXL-Lightning, all from this one key.
CLOUDFLARE_ACCOUNT_ID=     # dash.cloudflare.com -> Workers AI -> Use REST API (shows Account ID)
CLOUDFLARE_API_TOKEN=      # same page -> Create a Workers AI API token
TOGETHER_API_KEY=          # api.together.ai (FLUX.1-schnell-Free)
POLLINATIONS_API_KEY=   # optional; free key from pollinations.ai lifts the anonymous rate limit

# Video Generation (MiniMax / Hunyuan)
MINIMAX_API_KEY=your_minimax_key
HUNYUAN_API_KEY=your_hunyuan_key

# TTS Voiceover
ELEVENLABS_API_KEY=optional_elevenlabs_key
EDGE_TTS_VOICE=en-US-AriaNeural   # English only; Hindi/Punjabi use Edge neural voices automatically
# Natural Punjabi/Hindi voice. Edge's free service has NO Punjabi voice, so for Punjabi set one of these:
SARVAM_API_KEY=            # sarvam.ai (Bulbul v3, built for Indian languages; small free credit on signup)
# SARVAM_SPEAKER=shubh
# GEMINI_TTS_VOICE=Sulafat # Gemini speech (uses GEMINI_API_KEY); GEMINI_TTS_MODEL can override the model name
# ELEVENLABS_VOICE_ID=            # used only when FREE_MODE=false and ELEVENLABS_API_KEY is set

# Social Media API Credentials
INSTAGRAM_APP_ID=your_ig_app_id
INSTAGRAM_APP_SECRET=your_ig_app_secret
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# Server & Render Deployment
RENDER_EXTERNAL_URL=https://your-app.onrender.com
NODE_ENV=production
PORT=10000

# Keep-alive & Cron Secret
CRON_SECRET=saintpost_cron_secret_key

# Image quality control: every picture is inspected by a vision model; flawed ones (extra hands, wings through bodies,
# merged figures, stray text, wrong subject) are redrawn up to IMAGE_QA_RETRIES times, the last try with a simpler safe composition.
IMAGE_QA=true
IMAGE_QA_RETRIES=2
# GEMINI_VISION_MODEL=gemini-2.5-flash   # uses GEMINI_API_KEY (vision models have a free tier); else free OpenRouter vision models
# IMAGE_QA_MODEL=                        # optional OpenRouter vision model id (a cheap paid one is more dependable than free ones)

# Feature Flags & Modes
ENABLE_VIDEO_GENERATION=true
ENABLE_VOICEOVER=true
ENABLE_MUSIC=true
ENABLE_SUBTITLES=true
FREE_MODE=true
DRY_RUN=false
