{
  "name": "saintpost",
  "version": "1.0.0",
  "description": "Automated Catholic Feast Day Content Bot for Instagram Reels & YouTube Shorts",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "postinstall": "npm run build",
    "start": "node --max-old-space-size=380 dist/index.js",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "dev": "nodemon --exec ts-node src/index.ts",
    "db:migrate": "npm run build && node dist/db/migrate.js",
    "db:seed": "npm run build && node dist/db/seed.js",
    "test:pipeline": "ts-node -e \"import { SaintPostPipeline } from './src/engine/pipeline.js'; new SaintPostPipeline().runPipelineForSaint('St. Francis of Assisi');\"",
    "db:enrich": "npm run build && node dist/db/enrich.js",
    "db:verify-calendar": "npm run build && node dist/db/verifyCalendar.js",
    "check:providers": "npm run build && node scripts/check-providers.mjs"
  },
  "keywords": [
    "telegram-bot",
    "catholic-saints",
    "instagram-reels",
    "youtube-shorts",
    "ai-video",
    "render",
    "neon-db",
    "supercmo-skills"
  ],
  "author": "SaintPost Team",
  "license": "MIT",
  "dependencies": {
    "@indic-transliteration/sanscript": "^1.3.3",
    "@romcal/calendar.general-roman": "3.0.0-dev.140",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-tts-api": "^2.0.2",
    "jsonrepair": "^3.15.0",
    "msedge-tts": "^2.0.8",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "romcal": "3.0.0-dev.140",
    "sanctus": "^1.0.15",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
